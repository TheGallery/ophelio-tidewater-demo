{
  "name": "ophelio-tidewater-demo",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev --local",
    "preview": "tsx scripts/preview-mock.ts",
    "build": "wrangler deploy --dry-run --outdir dist",
    "deploy": "wrangler deploy",
    "setup": "tsx --env-file-if-exists=.dev.vars scripts/setup.ts",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src scripts test",
    "test": "vitest run",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "dependencies": {
    "@ophelio/sdk": "^0.6.1",
    "hono": "^4.7.0",
    "qrcode-generator": "^1.4.4"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261001.0",
    "@eslint/js": "^9.39.5",
    "@hono/node-server": "^2.1.3",
    "@types/node": "^22.14.0",
    "eslint": "^9.24.0",
    "prettier": "^3.9.9",
    "tsx": "^4.19.0",
    "typescript": "^5.8.0",
    "typescript-eslint": "^8.29.0",
    "vitest": "^5.0.3",
    "wrangler": "^4.7.0"
  },
  "overrides": {
    "sharp": "^0.35.5"
  }
}
